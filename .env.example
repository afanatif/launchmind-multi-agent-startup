# .env.example
# Copy this file to .env and fill in all values before running main.py
# NEVER commit your real .env file — it is listed in .gitignore

# ── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Hugging Face (fallback LLM when Gemini quota is exhausted) ───────────────
HF_API_KEY=your-huggingface-api-key-here

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal Access Token — needs: repo (full control)
GITHUB_TOKEN=your-github-personal-access-token-here
# Format: your-username/your-repo-name
GITHUB_REPO=your-username/launchmind-your-group-name

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot Token (xoxb-...) — needs scopes: chat:write, chat:write.public, channels:read, groups:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
# User OAuth Token (xoxp-...) — optional, used for diagnostics
SLACK_USER_TOKEN=xoxp-your-slack-user-token-here

# ── Brevo (Email) ────────────────────────────────────────────────────────────
# Create a free account at brevo.com — 300 emails/day free tier
BREVO_API_KEY=your-brevo-api-key-here
# Must be a verified sender in your Brevo account
BREVO_FROM_EMAIL=your-verified-sender@email.com
# Target inbox for the cold outreach email (use your own for testing)
TEST_EMAIL=your-test-inbox@email.com
